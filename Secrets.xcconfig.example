// Secrets.xcconfig.example
// Copy this file to Secrets.xcconfig and fill in your values.
// Find them in Firebase Console -> Project settings -> Your apps -> iOS app.

FIREBASE_API_KEY = your_firebase_api_key
FIREBASE_AUTH_DOMAIN = your-project.firebaseapp.com
FIREBASE_PROJECT_ID = your-project-id
FIREBASE_STORAGE_BUCKET = your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID = your_messaging_sender_id
FIREBASE_APP_ID = your_firebase_app_id
FIREBASE_CLIENT_ID = your_ios_oauth_client_id.apps.googleusercontent.com
FIREBASE_REVERSED_CLIENT_ID = com.googleusercontent.apps.your_ios_oauth_client_id
