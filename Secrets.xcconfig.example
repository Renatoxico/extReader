// Secrets.xcconfig.example
// Copy this file to Secrets.xcconfig and fill in your values.
// Find them at: https://supabase.com/dashboard → Project Settings → API

# ⚠️ Do NOT include https:// — xcconfig treats // as a comment.
SUPABASE_URL = your-project-ref.supabase.co
SUPABASE_ANON_KEY = your_supabase_anon_key_here
